{
  "name": "@sindresorhus/slugify",
  "version": "2.2.1-cjs.0",
  "private": true,
  "description": "CJS-callable shim for @sindresorhus/slugify (Mastra __toESM node-mode interop)",
  "main": "./index.cjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.cjs",
      "import": "./index.cjs",
      "default": "./index.cjs"
    }
  },
  "dependencies": {
    "slugify": "^1.6.6"
  }
}
