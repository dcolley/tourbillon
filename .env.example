# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tourbillon
# Max connections per app process (postgres.js pool). Keep low in dev — scheduler + web each open a pool.
DATABASE_POOL_MAX=5

# LLM provider env fallback (lmstudio | ollama | vllm | openai | openai-compatible)
# Seeds the default entry in Settings → LLM Providers when the registry is empty.
# Prefer managing multiple endpoints in the web UI at /settings.
LLM_PROVIDER=lmstudio
# chat = /v1/chat/completions, responses = OpenAI /v1/responses API
LLM_API_MODE=chat
# Optional unified overrides (used when provider-specific vars are unset)
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_DEFAULT_MODEL=

# LM Studio (local OpenAI-compatible API)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_DEFAULT_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Ollama (when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
# OLLAMA_DEFAULT_MODEL=llama3.2

# Registry providers support optional API keys (Bearer) and additional headers in Settings UI.
# Example for Azure-style endpoints: use type openai-compatible, set base URL, and add headers
# such as api-key or api-version in Settings → LLM Providers → Additional headers.

# Per-agent legacy overrides (agents.adapter_config JSON) — used when agents.provider_id is unset:
# { "provider": "ollama", "apiMode": "chat", "baseURL": "http://localhost:11434/v1" }

# Redis (for BullMQ)
REDIS_URL=redis://localhost:6379

# Auth
BETTER_AUTH_SECRET=change-me-in-production-use-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Optional: LAN / alternate hostnames for next dev (HMR websocket + dev assets; comma-separated)
# ALLOWED_DEV_ORIGINS=192.168.68.104

# Internal API (used by scheduler to call Next.js API routes)
INTERNAL_API_URL=http://localhost:3002

# Scheduler service key (wake API + routine issue create)
SCHEDULER_API_KEY=change-me-in-production

# WakeRunner HTTP endpoint (web → scheduler; no BullMQ heartbeats)
SCHEDULER_WAKE_PORT=3003
# SCHEDULER_WAKE_URL=http://127.0.0.1:3003

# Optional: Tavily web search (enables web-search-tavily toolset; company/agent key overrides)
# TAVILY_API_KEY=
# TAVILY_SEARCH_TIMEOUT_MS=20000

# Optional: SearXNG instance (base URL — no /mcp suffix; enables web-search toolset)
# SEARXNG_URL=http://localhost:8888
# SEARXNG_API_KEY=
# SEARXNG_SEARCH_TIMEOUT_MS=20000

# Company shared workspace (per-company document storage for agents)
# Relative paths resolve from the monorepo root, not process cwd.
COMPANY_WORKSPACE_ROOT=./data/company-workspaces

# Agent code execution sandbox (per-company / per-issue working directories)
# Relative paths resolve from the monorepo root, not process cwd.
EXECUTION_WORKSPACE_ROOT=./data/execution-workspaces
# none | seatbelt (macOS) | bwrap (Linux); unset uses platform recommendation
SANDBOX_ISOLATION=seatbelt
SANDBOX_COMMAND_TIMEOUT_MS=120000

# Optional: Mastra semantic memory recall (cross-issue patterns within goal/project scope)
# Requires an embedding model available via LM Studio or your OpenAI-compatible endpoint.
# MEMORY_SEMANTIC_RECALL=true
# MEMORY_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# Optional: Nitter instance
# NITTER_URL=http://localhost:8080

# Optional: Buffer MCP (enables buffer toolset)
# BUFFER_API_KEY=THnn-xxx
# BUFFER_MCP_URL=https://mcp.buffer.com/mcp

# Optional: Cursor-compatible MCP server declarations (default: <repo>/mcp.json)
# Copy mcp.json.example → mcp.json. Server ids must match keys (e.g. openbb-mcp, lean-mcp).
# TOURBILLON_MCP_CONFIG=/path/to/mcp.json
# Optional bearer tokens referenced as ${env:NAME} in mcp.json headers
# OPENBB_MCP_TOKEN=
# LEAN_MCP_TOKEN=

# Optional: Nous Portal inference API user tag (required for `:free` models)
# NOUS_INFERENCE_USER_TAG=derek

# Optional: App version label (sidebar + agent telemetry; defaults to package.json version)
# TOURBILLON_VERSION=0.2.0
# TOURBILLON_BUILD_COMMIT=abc1234
# TOURBILLON_BUILD_DATE=2026-07-10T00:00:00.000Z

# Optional: Worker concurrency
WORKER_CONCURRENCY=1

# Heartbeat liveness (scheduler worker + reconciler; sliding window — no absolute cap)
HEARTBEAT_PING_INTERVAL_SEC=20
HEARTBEAT_STALE_SEC=90
# Harness Session: abort if no controller progress events within this window (TokenLimiter hang defense)
HEARTBEAT_PROGRESS_STALE_SEC=600

# Fallback TokenLimiter cap when neither the provider nor the agent sets maxContextTokens.
# Prefer Max context tokens on the provider or agent generation settings form.
# HEARTBEAT_CONTEXT_TOKEN_LIMIT=120000

# Mastra observability (agent spans → PostgreSQL; off by default)
OBSERVABILITY_ENABLED=false
# model_step spans hold final response text per LLM step; set true to also store streamed MODEL_CHUNK spans (text/reasoning, high volume)
OBSERVABILITY_STORE_MODEL_CHUNKS=false
OBSERVABILITY_PREVIEW_CHARS=500
OBSERVABILITY_MAX_PAYLOAD_BYTES=32768

# Optional: Arize Phoenix OTLP export (@mastra/arize). Independent of Postgres UI exporter.
# PHOENIX_COLLECTOR_ENABLED=false
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
# PHOENIX_PROJECT_NAME=tourbillon
# PHOENIX_API_KEY=